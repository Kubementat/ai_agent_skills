# planka-development-flow dispatcher config
# Sourced by dispatch.sh — plain shell variables, no parser needed.

# --- Planka board (AI-Orchestration project, Dispatch Board) ---
PLANKA_PROJECT=1877211143563379717
PLANKA_BOARD=1877212014779040775

# --- Lists (Dispatch Board) ---
LIST_INBOX=1877212080554116107
LIST_READY=1877212081032266764
LIST_CLAIMED=1877212081476862989
LIST_IN_PROGRESS=1877212081896293390
LIST_READY_REVIEW=1877212082332501007
LIST_AI_REVIEW=1877225921337885729
LIST_HUMAN_REVIEW=1877225921774093346
LIST_DONE=1877225922260632611
LIST_REJECTED=1877212082768708624

# --- Custom fields (Dispatch base group) ---
FIELD_GROUP=Dispatch
BASE_GROUP=1877213044086408210
FIELD_PROJECT=1877213106237604883
FIELD_ATTEMPTS=1877213106724144148

# --- Dispatcher behavior ---
MAX_PARALLEL=2          # max tickets in flight per dispatch run
MAX_ATTEMPTS=3          # bounce limit, then Rejected
CARD_TIMEOUT=3600       # seconds to wait for one agent (polling)
POLL_INTERVAL=20        # seconds between card-state polls

# --- Agent launch ---
HERDR_RUN=/home/verfeinerer/.pi/agent/skills/herdr-cli/scripts/run-pi-herdr.sh
MODEL=dgx/qwen3.6-35b-mtp
CARD_TIMEOUT_MS=1800000 # herdr-side timeout (ms)

# --- Worktrees ---
WT_ROOT=/home/verfeinerer/dev/worktrees

# --- Per-project settings ---
# Key format: PROJ_<key>_repo / _base_ref / _test / _hard / _soft
# <key> = the card's "project" field value with non-alphanumerics replaced
# by _ (ai-proxy-king -> ai_proxy_king; shell variable names).
# _hard / _soft are space-separated glob patterns (case syntax).

PROJ_ai_proxy_king_repo="/home/verfeinerer/dev/os_projects/ai-proxy-king"
PROJ_ai_proxy_king_base_ref="main"
PROJ_ai_proxy_king_test="go test ./..."
PROJ_ai_proxy_king_hard=".env* *.pem keys/* secrets/*"
PROJ_ai_proxy_king_soft="Dockerfile docker-compose.yml .gitlab/* .gitlab-ci.yml go.mod go.sum"
